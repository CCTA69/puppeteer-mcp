{
  "name": "puppeteer-mcp",
  "version": "1.1.0",
  "description": "A local MCP server for browser automation with Puppeteer",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "test:unit": "node --test tests/protocol.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/session.test.mjs tests/actions.test.mjs tests/screenshot.test.mjs tests/lifecycle.test.mjs",
    "test": "npm run build && npm run test:unit && npm run test:integration",
    "test:stress": "node --test tests/recovery-stress.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CCTA69/puppeteer-mcp.git"
  },
  "keywords": [
    "mcp",
    "puppeteer",
    "browser",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CCTA69/puppeteer-mcp/issues"
  },
  "homepage": "https://github.com/CCTA69/puppeteer-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "puppeteer": "^25.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
